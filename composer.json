{
    "name": "drupalwxt/site-wxt",
    "description": "Project template for Drupal 10 sites built with the WxT distribution.",
    "type": "project",
    "license": "GPL-2.0+",
    "minimum-stability": "dev",
    "prefer-stable": false,
    "require": {
        "composer/installers": "^2.1",
        "cweagans/composer-patches": "^1.7",
        "drupal/core-composer-scaffold": "10.5.x",
        "danrod96-new/wxt": "5.4.4"
    },
    "require-dev": {
        "drupal/core-dev": "10.5.x",
        "drupal/drupal-extension": "5.0.0-alpha1",
        "drush/drush": "^12.4.3",
        "oomphinc/composer-installers-extender": "^1.1 || ^2",
        "squizlabs/php_codesniffer": "3.*",
        "phpspec/prophecy-phpunit": "^2",
        "vlucas/phpdotenv": "^5.1",
        "webflo/drupal-finder": "^1.2"
    },
    "config": {
        "discard-changes": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "package",
            "package": {
              "name": "danrod96-new/wxt",
              "version": "5.4.4",
              "type": "drupal-profile",
              "extra": {
                "installer-name": "wxt"
              },
              "dist": {
                "url": "https://github.com/danrod96-new/wxt/archive/refs/tags/5.4.4.zip",
                "type": "zip"
              },
              "license": "GNU"
            }
      }
    ],
    "scripts": {
        "drush": "docker compose exec -w /var/www/html web /var/www/vendor/bin/drush",
        "post-create-project-cmd": "rm -r -f behat.yml",
        "quick-start": [
            "composer install"
        ]
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/{$name}": [
                "type:drupal-console-library",
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": { },
        "patches-ignore": { }
    },
    "autoload": {
        "classmap": [
            "scripts/ScriptHandler.php"
        ]
    }
}
